@model IEnumerable<Book.Models.Cart>

@{
    ViewData["Title"] = "My Cart";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">📚 My Cart</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Your cart is empty. <a href="/Customer/Books">Browse books</a> to add items!
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-primary">
                <tr class="text-center">
                    <th>Image</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-id="@item.Id" class="text-center">
                        <td><img src="@item.Product.ImageUrl" width="80" class="rounded" /></td>
                        <td>@item.Product.Title</td>
                        <td>@item.Product.Category.Name</td>
                        <td>$@item.Product.Price</td>
                        <td>@item.Count</td>
                        <td>$@(item.Product.Price * item.Count)</td>
                        <td>
                            <button class="btn btn-sm btn-danger remove-btn">
                                <i class="bi bi-trash"></i> Remove
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <h4>
                Total Amount:
                <span class="text-success fw-bold">
                    @Model.Sum(i => i.Product.Price * i.Count).ToString("c")
                </span>
            </h4>

            <button id="bookNowBtn" class="btn btn-primary btn-lg">
                <i class="bi bi-book"></i> Book Now
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 🗑 Remove item
            $(".remove-btn").on("click", function () {
                const row = $(this).closest("tr");
                const id = row.data("id");

                $.ajax({
                    url: '/Customer/Cart/Remove',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message);
                            row.fadeOut(300, function () { $(this).remove(); });
                            setTimeout(() => location.reload(), 500);
                        }
                    },
                    error: function () {
                        toastr.error("Failed to remove item.");
                    }
                });
            });

            // 📘 Book Now
            $("#bookNowBtn").on("click", function () {
                $.ajax({
                    url: '/Customer/Cart/BookNow',
                    type: 'POST',
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message);
                            setTimeout(() => location.reload(), 1000);
                        }
                    },
                    error: function () {
                        toastr.error("Something went wrong while booking.");
                    }
                });
            });
        });
    </script>
}
