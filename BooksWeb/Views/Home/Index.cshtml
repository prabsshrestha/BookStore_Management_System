@{
    var role = ViewData["Role"]?.ToString();
    var isAuthenticated = User.Identity.IsAuthenticated;
    var username = User.Identity.Name;
    var name = ViewData["DisplayName"].ToString() ?? "Guest";
    int categoriescount = ViewBag.TotalCategories ?? 0;
    int productCount = ViewBag.TotalProduct ?? 0;
    int totalcartCount = ViewBag.TotalCart ?? 0;
}

<div class="jumbotron text-center" style="padding-top:12px;">
    <h1>Welcome @name!</h1>
    @if (isAuthenticated)
    {
        if (role == "Admin")
        {
            <p class="lead">This is your Book Store Management Admin Dashboard.</p>
        }
        else
        {
            <span>
                <a href="/Customer/Books" class="btn btn-link p-0">
                    Click Here!
                </a> <span>to explore the avaible books</span>
            </span>
        }
    }
    else
    {
        <p class="lead">Please, login to get access to the application.</p>

        <a class="btn btn-primary" href="/Identity/Account/Register">Create an account</a>
        <a class="btn btn-secondary" href="/Identity/Account/Login">Login</a>
    }
</div>

@if (isAuthenticated)
{
    if(role == "Admin")
    {
        <div class="row justify-content-center" style="max-width: 900px; margin: auto; gap: 15px; margin-top: 20px;">

            <!-- Categories Card -->
           <div class="custom-box p-4 text-center">
               <h3>@categoriescount</h3>
               <p>Total Categories</p>
               <i class="fas fa-users fa-lg mb-2"></i><br />
                <a href="/Admin/Category" class="btn btn-link p-0">
                    More info <i class="fas fa-arrow-circle-right"></i>
                </a>
           </div>

            <div class="custom-box p-4 text-center">
                <h3>@productCount</h3>
                <p>Total Products</p>
                <i class="fas fa-users fa-lg mb-2"></i><br />
                <a href="/Admin/Product" class="btn btn-link p-0">
                    More info <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>

        </div>
    }
    else
    {
        <div class="row justify-content-center" style="max-width: 900px; margin: auto; gap: 15px; margin-top: 20px;">

            <!-- Cart Total Card -->
            <div class="custom-box p-4 text-center">
                <h3>@totalcartCount</h3>
                <p>Total Cart</p>
                <i class="fas fa-users fa-lg mb-2"></i><br />
                <a href="/Customer/Cart" class="btn btn-link p-0">
                    More info <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>

        </div>
    }
}
